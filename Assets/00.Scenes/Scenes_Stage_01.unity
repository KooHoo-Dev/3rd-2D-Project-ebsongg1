      m_Calls: []
  m_text: "\uC790\uB791\uC2A4\uB7EC\uC6B4  \uC6B0\uB9AC\uC758 \uB9C8\uBC95\uC0AC\uC5EC.\n\uC790\uB124\uAC00
    \uD640\uB85C \uB2E4\uB978 \uC784\uBB34\uB97C \uB9E1\uACE0 \uC788\uB294 \uB3D9\uC548
    \uD070 \uC77C\uC774 \uC0DD\uACBC\uB2E4\uB124.\r\n\r\n\uB3D9\uBD80 \uD3D0\uD5C8\uB85C
    \uD30C\uACAC\uB41C \uB9C8\uBC95\uC0AC \uC120\uBC1C\uB300 \uC804\uC6D0\uC758 \uC5F0\uB77D\uC774
    \uC644\uC804\uD788 \uB450\uC808\uB418\uC5C8\uB124.\r\n\uADF8 \uC5B4\uB5A0\uD55C
    \uC804\uB839\uB3C4, \uC0DD\uC874 \uBCF4\uACE0\uB3C4 \uB3CC\uC544\uC624\uC9C0
    \uC54A\uC740 \uC9C0\uAE08 \uC218\uB3C4\uC758 \uC0C1\uD0DC\uB3C4 \uC2EC\uC0C1\uCE58
    \uC54A\uB124.\r\n\r\n\uBD80\uB514 \uD604\uC7A5\uC73C\uB85C \uC9C4\uC785\uD558\uC5EC
    \uC0C1\uD669\uC744 \uD30C\uC545\uD558\uACE0,\r\n\uB300\uCCB4 \uBB34\uC2A8 \uC77C\uC774
    \uBC8C\uC5B4\uC9C4 \uAC74\uC9C0 \uC815\uD655\uD788 \uBCF4\uACE0\uD574 \uC8FC\uAC8C.\r\n\r\n\uC218\uB3C4\uAC00
    \uC9C4\uC815\uB418\uBA74 \uACE7 \uAE30\uC0AC\uB2E8\uC744 \uD30C\uACAC\uD560 
    \uD130\uC774\uB2C8,\r\n\uBA3C\uC800 \uD604\uC7A5\uC73C\uB85C \uAC00 \uC790\uB124\uC758
    \uC18C\uC784\uC744 \uB2E4\uD574\uC8FC\uAE38 \uBC14\uB77C\uB124."
